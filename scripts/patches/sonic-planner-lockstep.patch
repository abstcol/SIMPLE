+    bool LockstepPlannerBoundary(const LockstepEnvelope& envelope) {
+      const auto state = low_state_buffer_.GetDataWithTime().data;
+      if (!state || state->reserve() != envelope.Reserve()) return false;
+
+      // NAV1, mode, movement[3], facing[3], speed and height. Piggyback on
+      // the unused remote bytes only in this loopback simulation mode, so
+      // retries and acknowledgement use exactly the same state and goal.
+      const auto& wire = state->wireless_remote();
+      uint32_t signature, mode;
+      std::array<float, 8> goal{};
+      std::memcpy(&signature, wire.data(), sizeof(signature));
+      std::memcpy(&mode, wire.data() + 4, sizeof(mode));
+      std::memcpy(goal.data(), wire.data() + 8, sizeof(goal));
+      if (signature != 0x3156414eU || mode > 1 ||
+          !std::all_of(goal.begin(), goal.end(), [](float value) { return std::isfinite(value); })) {
+        return false;
+      }
+
+      operator_state.start = true;
+      if (program_state_ != ProgramState::CONTROL) return true;
+      movement_state_buffer_.SetData(MovementState(
+          static_cast<int>(mode), {goal[0], goal[1], goal[2]},
+          {goal[3], goal[4], goal[5]}, goal[6], goal[7]));
+
+      // The native planner ticks at 10 Hz against the 50 Hz policy. Seed
+      // the first motion immediately, then keep the cadence in sim steps.
+      const bool first = !planner_->planner_state_.initialized;
+      const auto stride = static_cast<uint32_t>(std::lround(planner_dt_ / control_dt_));
+      if (first || envelope.sim_step - last_lockstep_plan_step_ >= stride) {
+        last_lockstep_plan_step_ = envelope.sim_step;
+        planner_->planner_state_.enabled = true;
+        Planner();
+        if (!planner_->planner_state_.initialized) return false;
+        std::cout << "[LockstepPlanner] session=" << envelope.session
+                  << " step=" << envelope.sim_step << " mode=" << mode << std::endl;
+      }
+      if (first && !CurrentFrameAdvancement()) return false;
+      operator_state.play = true;
+      return true;
+    }
